# Base URL of the Pinky backend API (used at build time by Vite).
# - In development leave empty to use the dev-server proxy defined in vite.config.ts.
# - In production set to the absolute URL of the backend, e.g. https://brain.tudominio.com
VITE_API_BASE_URL=

# Dev-only: target of the Vite dev proxy for API routes (/auth, /documents, ...).
# Only used when running `npm run dev`. Ignored in production builds.
VITE_API_PROXY_TARGET=http://localhost:8081
