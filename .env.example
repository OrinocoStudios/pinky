PORT=8081
NODE_ENV=development

# Security
API_KEY=change-me-in-production
ENABLE_API_KEY_AUTH=false
ENABLE_MULTI_TENANT=false

# Auth
# In production with SPA on a separate subdomain, use:
#   AUTH_COOKIE_SECURE=true
#   AUTH_COOKIE_SAME_SITE=none   # required for cross-site cookies (needs Secure=true)
#   AUTH_SUCCESS_URL=https://app.tudominio.com
#   AUTH_FAILURE_URL=https://app.tudominio.com/login?error=unauthorized
#   GOOGLE_CALLBACK_URL=https://brain.tudominio.com/auth/google/callback
#   GITHUB_CALLBACK_URL=https://brain.tudominio.com/auth/github/callback
AUTH_ENABLE_DEV_LOGIN=false
AUTH_JWT_SECRET=change-me-auth-secret
AUTH_JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=pinky_auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_ALLOWED_ADMIN_EMAILS=
AUTH_SUCCESS_URL=http://localhost:5173
AUTH_FAILURE_URL=http://localhost:5173/login?error=unauthorized
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8081/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8081/auth/github/callback

# CORS (for browser-based consumers)
# In production (SPA on a different subdomain), set:
#   CORS_ENABLED=true
#   CORS_ORIGINS=https://app.tudominio.com
# Leave empty only for server-to-server integrations.
CORS_ENABLED=false
# Comma-separated allowlist origins (empty = allow all origins when enabled)
CORS_ORIGINS=

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_GLOBAL=10
RATE_LIMIT_QUERY=5
RATE_LIMIT_UPLOAD=3
RATE_LIMIT_INGEST=5

# Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=text/plain,text/markdown,application/json,text/csv,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Idempotency (SHA-256 checksum)
ENABLE_CHECKSUM_VALIDATION=true

# Observability
# GET /metrics - Prometheus metrics (path: /metrics)
# GET /health - Health check with Neo4j + LLM status

NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

AI_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EXTRACTION_MODEL=llama3.2
OLLAMA_AI_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=1000
OLLAMA_TIMEOUT_MS=60000

OBJECT_STORE_PATH=./data/objects
TOP_K=8
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# LLM Configuration
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_BASE_URL=https://ollama.orinocostudios.dev/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen35-08b
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_EXTRACTION_MODEL=qwen35-08b
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1000
OPENAI_TIMEOUT_MS=120000

# Anthropic Configuration (alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_MAX_TOKENS=1000
ANTHROPIC_TIMEOUT_MS=30000
