# Copia estas variables al panel de Dokploy (o .env del compose).
# Backend: compose build context = raíz `pinky/` → `docker-compose -f docker-compose.prod.yml`
# Frontend: mismo contexto → `docker-compose -f docker-compose.web.yml`
# Documentación paso a paso: docs/DOKPLOY.md

# -----------------------------------------------------------------------------
# Neo4j (servicio neo4j + app; deben coincidir usuario/contraseña)
# -----------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar-en-produccion-seguro

# -----------------------------------------------------------------------------
# Backend (brain-app) — seguridad
# -----------------------------------------------------------------------------
PORT=8081
NODE_ENV=production
API_KEY=cambiar-api-key-larga
ENABLE_API_KEY_AUTH=true

# -----------------------------------------------------------------------------
# CORS y front en otro dominio
# -----------------------------------------------------------------------------
CORS_ENABLED=true
CORS_ORIGINS=https://app.tudominio.com

# -----------------------------------------------------------------------------
# Auth / cookies cross-site (front https://app… API https://api…)
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=cambiar-secreto-jwt-largo
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=none
AUTH_SUCCESS_URL=https://app.tudominio.com
AUTH_FAILURE_URL=https://app.tudominio.com/login?error=unauthorized

# OAuth: URLs de callback = dominio público del API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.tudominio.com/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.tudominio.com/auth/github/callback

# -----------------------------------------------------------------------------
# LLM (elige proveedor según producción)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Imágenes (opcional; por defecto GHCR según docker-compose.*.yml)
# -----------------------------------------------------------------------------
# BRAIN_IMAGE=ghcr.io/orinocostudios/pinky:latest
# WEB_IMAGE=ghcr.io/orinocostudios/pinky-web:latest

# -----------------------------------------------------------------------------
# Frontend — obligatorio en BUILD de la imagen web (no solo runtime)
# -----------------------------------------------------------------------------
# URL absoluta del API público (sin barra final si tu cliente no la añade)
VITE_API_BASE_URL=https://api.tudominio.com
#
# En GitHub Actions duplica VITE_API_BASE_URL como Secret del repositorio para el
# workflow release.yml (build de pinky-web). Los webhooks Dokploy van en:
# DOKPLOY_WEBHOOK_BACKEND, DOKPLOY_WEBHOOK_WEB, opcional DOKPLOY_WEBHOOK_STACK.

# Puerto host del servicio web (compose)
# WEB_PORT=8080
AI_URL=https://ollama.orinocostudios.dev/v1
